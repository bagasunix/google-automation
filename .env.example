# ==========================================
# Google Automation - Environment Variables
# ==========================================

# Webshare Proxy API Keys (comma-separated for multi-key rotation)
WEBSHARE_API_KEYS=your_webshare_key_1,your_webshare_key_2

# Speech-to-Text / Audio CAPTCHA (OpenAI, Groq, etc.)
OPENAI_API_KEY=your_groq_or_openai_api_key

# Token Injection CAPTCHA Solver (Capsolver, 2Captcha)
TOKEN_SOLVER_KEY=your_capsolver_key

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard login — the only place these credentials should live
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change_me
